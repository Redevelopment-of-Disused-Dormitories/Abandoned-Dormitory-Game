; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Abandoned Dormitory Game"
config/description="7人合作恐怖遊戲：在廢棄宿舍中收集7件遺物逃出"
config/tags=PackedStringArray("game", "horror", "multiplayer")
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

steam_manager="*res://scripts/autoloads/steam_manager.gd"
voice_manager="*res://scripts/autoloads/voice_manager.gd"
game_manager="*res://scripts/autoloads/game_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

